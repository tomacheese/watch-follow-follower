{
  "name": "watch-follow-follower",
  "description": "Check X (Twitter) followers/following changes and optionally notify Discord.",
  "version": "3.0.0",
  "type": "module",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "bugs": {
    "url": "https://github.com/tomacheese/watch-follow-follower/issues"
  },
  "dependencies": {
    "@book000/node-utils": "1.25.126",
    "@the-convocation/twitter-scraper": "0.22.3",
    "cycletls": "2.0.5",
    "headers-polyfill": "5.0.1",
    "tsx": "4.23.15",
    "twitter-openapi-typescript": "0.0.56"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.74",
    "@types/node": "25.9.8",
    "@types/tough-cookie": "4.0.5",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "run-z": "2.1.0",
    "typescript": "6.0.3"
  },
  "homepage": "https://github.com/tomacheese/watch-follow-follower",
  "license": "MIT",
  "main": "dist/main.js",
